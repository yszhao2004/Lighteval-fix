+def _module_level_bindings(statements: list) -> list[str]:
+    """Names the candidate binds at module level.
+
+    Collected so that wrapping the program in a function does not turn its
+    module namespace into a function-local one. Assignments, augmented and
+    annotated assignments, loop and with targets, and def/class names all
+    count; anything nested inside a function or class body does not, because
+    those were already local.
+    """
+    names: set[str] = set()
+    for statement in statements:
+        if isinstance(statement, (ast.Assign, ast.AnnAssign, ast.AugAssign)):
+            targets = statement.targets if isinstance(statement, ast.Assign) else [statement.target]
+            for target in targets:
+                names.update(node.id for node in ast.walk(target) if isinstance(node, ast.Name))
+        elif isinstance(statement, (ast.For, ast.AsyncFor)):
+            names.update(node.id for node in ast.walk(statement.target) if isinstance(node, ast.Name))
+        elif isinstance(statement, (ast.With, ast.AsyncWith)):
+            for item in statement.items:
+                if item.optional_vars is not None:
+                    names.update(
+                        node.id for node in ast.walk(item.optional_vars) if isinstance(node, ast.Name)
+                    )
+        elif isinstance(statement, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
+            names.add(statement.name)
+    return sorted(names)
+
